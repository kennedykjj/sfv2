CREATE TABLE card (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    column_name TEXT NOT NULL
);

CREATE TABLE event (
    seq INTEGER PRIMARY KEY AUTOINCREMENT,
    id TEXT NOT NULL UNIQUE,
    card_id TEXT NOT NULL REFERENCES card(id),
    at TEXT NOT NULL,
    actor TEXT NOT NULL,
    type TEXT NOT NULL,
    payload_json TEXT NOT NULL
);

CREATE INDEX event_card_id ON event(card_id);

CREATE TABLE spec (
    card_id TEXT NOT NULL PRIMARY KEY,
    path TEXT NOT NULL,
    hash TEXT NOT NULL
);

upsertSpec:
INSERT OR REPLACE INTO spec(card_id, path, hash) VALUES (?, ?, ?);

selectSpec:
SELECT path, hash FROM spec WHERE card_id = ?;

insertCardIfAbsent:
INSERT OR IGNORE INTO card (id, title, column_name)
VALUES (:id, :title, :column_name);

updateCard:
UPDATE card SET title = :title, column_name = :column_name WHERE id = :id;

insertEvent:
INSERT INTO event (id, card_id, at, actor, type, payload_json)
VALUES (:id, :cardId, :at, :actor, :type, :payloadJson);

eventPayloadsByCard:
SELECT payload_json FROM event WHERE card_id = :cardId ORDER BY seq;

allCards:
SELECT id, title, column_name FROM card ORDER BY rowid;

cardById:
SELECT title, column_name FROM card WHERE id = :id;
