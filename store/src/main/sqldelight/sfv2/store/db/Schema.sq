CREATE TABLE card (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    column_name TEXT NOT NULL
);

CREATE TABLE event (
    id TEXT NOT NULL PRIMARY KEY,
    card_id TEXT NOT NULL,
    at TEXT NOT NULL,
    actor TEXT NOT NULL,
    type TEXT NOT NULL,
    payload_json TEXT NOT NULL
);

CREATE INDEX event_card_id ON event(card_id);

upsertCard:
INSERT OR REPLACE INTO card (id, title, column_name)
VALUES (:id, :title, :column_name);

insertEvent:
INSERT INTO event (id, card_id, at, actor, type, payload_json)
VALUES (:id, :cardId, :at, :actor, :type, :payloadJson);

eventPayloadsByCard:
SELECT payload_json FROM event WHERE card_id = :cardId ORDER BY rowid;

cardById:
SELECT title, column_name FROM card WHERE id = :id;
