CREATE TABLE card (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    column_name TEXT NOT NULL
);

CREATE TABLE event (
    id TEXT NOT NULL PRIMARY KEY,
    card_id TEXT NOT NULL,
    at TEXT NOT NULL,
    actor TEXT NOT NULL,
    type TEXT NOT NULL,
    payload_json TEXT NOT NULL
);

CREATE INDEX event_card_id ON event(card_id);

CREATE TABLE spec (
    card_id TEXT NOT NULL PRIMARY KEY,
    path TEXT NOT NULL,
    hash TEXT NOT NULL
);

upsertSpec:
INSERT OR REPLACE INTO spec(card_id, path, hash) VALUES (?, ?, ?);

selectSpec:
SELECT path, hash FROM spec WHERE card_id = ?;
